# --- Database (packages/db) ---
DATABASE_URL=postgres://kargotrack:kargotrack@localhost:5432/kargotrack

# --- Bot (apps/bot) ---
PORT=8443
# The bot reads DATABASE_URL too (to resolve tenants by bot token).
# Local testing without a public URL: run long-polling instead of webhooks.
# BOT_POLLING=true
# Restrict polling to a single tenant's BotFather token (else all tenants poll):
# BOT_POLLING_TOKEN=123456789:your-real-bot-token
# Warehouse photo storage root (SPEC §3.8):
# UPLOADS_DIR=/data/uploads

# --- Web (apps/web) ---
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Secrets (added in later feature tasks; not used by the skeleton) ---
# SUPERADMIN_TOKEN=
# SESSION_SECRET=
