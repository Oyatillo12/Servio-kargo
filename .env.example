# SERVIO Kargo environment. Copy to `.env` and fill in. Consumed by
# docker-compose.prod.yml, deploy.sh, and the app processes. One line each.

# --- Domain & HTTPS (Caddy) -------------------------------------------------
DOMAIN=kargotrack.uz                       # Root domain; admin panel served here, bot at bot.<DOMAIN>. No scheme.
ACME_EMAIL=you@example.com                 # Email Let's Encrypt uses for cert notices.

# --- Postgres ---------------------------------------------------------------
POSTGRES_USER=kargotrack                   # DB superuser for the app's database.
POSTGRES_PASSWORD=change-me-strong-db-pass # DB password. Use a long random value.
POSTGRES_DB=kargotrack                     # Database name.

# --- Database connection (used by web + bot + migrations) -------------------
DATABASE_URL=postgres://kargotrack:change-me-strong-db-pass@postgres:5432/kargotrack  # Host is the compose service name `postgres`; match the three POSTGRES_* values. For local `pnpm dev` (not Docker) use host `localhost`.

# --- Bot (apps/bot) ---------------------------------------------------------
PORT=8443                                  # Internal HTTP port for the bot's webhook/health server.
# BOT_POLLING=true                         # Leave UNSET in production (webhook mode). Only for local dev without a public URL.
# BOT_POLLING_TOKEN=123456789:token        # Dev-only: restrict polling to one tenant's BotFather token.

# --- Web (apps/web) ---------------------------------------------------------
SESSION_SECRET=change-me-long-random-secret       # Signs the admin session cookie. >=16 random chars. `openssl rand -base64 32`.
# NEXT_PUBLIC_APP_URL=https://kargotrack.uz        # Optional public origin of the admin panel.

# --- Super-admin onboarding area (SPEC §6) ----------------------------------
SUPERADMIN_TOKEN=change-me-long-random-superadmin-token  # Guards /sa tenant onboarding. Treat like a password. `openssl rand -base64 32`.
WEBHOOK_BASE_URL=https://bot.kargotrack.uz               # Public HTTPS origin of the BOT server. Onboarding sets each webhook to {this}/webhook/{token}. Use bot.<DOMAIN>.

# --- Shared file storage (warehouse photos, SPEC §3.8) ----------------------
UPLOADS_DIR=/data/uploads                  # Container path for photos; backed by the `uploads` docker volume shared by web + bot.

# --- Error reporting (AUDIT.md T5) ------------------------------------------
# OPTIONAL. Leave unset and both apps run exactly as before, reporting disabled.
# Set it and every error already logged at `error` level is also reported, so a
# tenant's bot cannot fail silently. Customer phones, track codes, bot tokens and
# connection strings are stripped before anything leaves the server
# (packages/shared/src/observability/scrub.ts). Pick an EU-region Sentry project
# to keep data in Europe.
# SENTRY_DSN=https://<key>@<org>.ingest.de.sentry.io/<project>
# LOG_LEVEL=info                           # pino level: trace|debug|info|warn|error. Defaults: info in prod, debug in dev.
