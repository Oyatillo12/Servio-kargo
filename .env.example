# --- Database (packages/db) ---
DATABASE_URL=postgres://kargotrack:kargotrack@localhost:5432/kargotrack

# --- Bot (apps/bot) ---
PORT=8443
# The bot reads DATABASE_URL too (to resolve tenants by bot token).
# Local testing without a public URL: run long-polling instead of webhooks.
# BOT_POLLING=true
# Restrict polling to a single tenant's BotFather token (else all tenants poll):
# BOT_POLLING_TOKEN=123456789:your-real-bot-token
# Warehouse photo storage root (SPEC §3.8):
# UPLOADS_DIR=/data/uploads

# --- Web (apps/web) ---
# The web app reads DATABASE_URL too (tenant-scoped admin queries).
# Signs the admin session cookie (SPEC §8). Use a long random value (>=16 chars).
SESSION_SECRET=change-me-to-a-long-random-secret
# Warehouse photo storage root, shared with the bot (SPEC §3.8):
# UPLOADS_DIR=/data/uploads
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Super-admin area (SPEC §6) ---
# Shared secret guarding /sa (tenant onboarding). Separate from tenant admin
# auth. Use a long random value (>=8 chars; treat like a password).
SUPERADMIN_TOKEN=change-me-to-a-long-random-superadmin-token
# Public HTTPS origin of the BOT server — where Telegram POSTs updates. The
# onboarding flow sets each new bot's webhook to {WEBHOOK_BASE_URL}/webhook/{token}.
# Example: https://bot.kargotrack.uz  (no trailing slash needed)
WEBHOOK_BASE_URL=https://bot.example.com
